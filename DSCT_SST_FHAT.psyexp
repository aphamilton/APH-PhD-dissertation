      <CodeComponent name="code_spatial_span_3">
        <Param val="" valType="extendedCode" updates="constant" name="Before Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Before JS Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Begin Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Begin JS Experiment"/>
        <Param val="squares = [square_19, square_20, square_21, square_22, square_23, square_24, square_25, square_26, square_27];&amp;#10;highlights = [Flash1, Flash2, Flash3, Flash4, Flash5, Flash6, Flash7, Flash8, Flash9, Flash10];&amp;#10;start_time = 2;&amp;#10;flash_time = 1;&amp;#10;end_time = (flash_time * Num_of_flashes);&amp;#10;end_delay = 0.75;&amp;#10;end_delay_time = 999999;&amp;#10;squares_clicked = [];&amp;#10;click_count = 0;&amp;#10;output_column_name = 'bad_name';&amp;#10;&amp;#10;counter = new util.Clock();&amp;#10;inactive_color = new util.Color([0.6549, 0.6549, 0.6549]);&amp;#10;activated_color = new util.Color([-0.3, -0.3, -0.3]);&amp;#10;highlight_color = new util.Color([Red, Green, Blue]);&amp;#10;document.body.style.cursor='auto';&amp;#10;&amp;#10;for (var i, _pj_c = 0, _pj_a = util.range(9), _pj_b = _pj_a.length; (_pj_c &lt; _pj_b); _pj_c += 1) {&amp;#10;    i = _pj_a[_pj_c];&amp;#10;    squares[i].fillColor = inactive_color;&amp;#10;}&amp;#10;" valType="extendedCode" updates="constant" name="Begin JS Routine"/>
        <Param val="squares = [square_19, square_20, square_21, square_22, square_23, square_24, square_25, square_26, square_27]&amp;#10;highlights = [Flash1, Flash2, Flash3, Flash4, Flash5, Flash6, Flash7, Flash8, Flash9, Flash10]&amp;#10;start_time = 2&amp;#10;flash_time = 1&amp;#10;end_time = (flash_time * Num_of_flashes)&amp;#10;end_delay = 0.75&amp;#10;end_delay_time = 999999&amp;#10;squares_clicked = []&amp;#10;click_count = 0&amp;#10;output_column_name = 'bad_name'&amp;#10;&amp;#10;# These have to be different in JavaScript&amp;#10;counter = core.Clock()&amp;#10;inactive_color = 'lightgrey'&amp;#10;activated_color = 'darkgrey'&amp;#10;highlight_color = [Red, Green, Blue]&amp;#10;win.setMouseVisible(True);&amp;#10;&amp;#10;for i in range(9):&amp;#10;    squares[i].color = inactive_color" valType="extendedCode" updates="constant" name="Begin Routine"/>
        <Param val="Both" valType="str" updates="None" name="Code Type"/>
        <Param val="#Return time in seconds since routine began&amp;#10;current_time = counter.getTime() - start_time&amp;#10;&amp;#10;current_flash = current_time / flash_time&amp;#10;current_index = int(current_flash)&amp;#10;if current_time &gt;= 0 and current_index &gt;= 0 and current_index &lt; Num_of_flashes:&amp;#10;    flash_fraction = current_flash - current_index&amp;#10;    highlight = highlights[current_index] - 1&amp;#10;    if flash_fraction &lt; 0.67:&amp;#10;        squares[highlight].color = highlight_color&amp;#10;    else:&amp;#10;        squares[highlight].color = inactive_color&amp;#10;        &amp;#10;if current_time &gt;= end_time:&amp;#10;    for i in range(9):&amp;#10;        if mouse.isPressedIn(squares[i]):&amp;#10;            if click_count &gt; 0:&amp;#10;                if squares_clicked[click_count - 1] == i + 1:&amp;#10;                    break   # duplicate, don't save&amp;#10;                    &amp;#10;            squares_clicked.append(i + 1)&amp;#10;            click_count += 1&amp;#10;            for j in range(9):&amp;#10;                squares[j].color = inactive_color&amp;#10;            squares[i].color = activated_color&amp;#10;            &amp;#10;            if click_count == Num_of_flashes:&amp;#10;                output_column_name = str('Output_sst')&amp;#10;                thisExp.addData(output_column_name, squares_clicked)&amp;#10;                for j in range(Num_of_flashes):&amp;#10;                    if squares_clicked[j] != highlights[j]:&amp;#10;                        SST_trials3.finished = True&amp;#10;                end_delay_time = current_time + end_delay&amp;#10;&amp;#10;if current_time &gt;= end_delay_time:&amp;#10;    continueRoutine = False&amp;#10;&amp;#10;# https://discourse.psychopy.org/t/code-component-to-count-mouse-clicks/11621/26&amp;#10;&amp;#10;# 'output_sst_' + str(Num_of_flashes)&amp;#10;&amp;#10;&amp;#10;" valType="extendedCode" updates="constant" name="Each Frame"/>
        <Param val="current_time = (counter.getTime() - start_time);&amp;#10;current_flash = (current_time / flash_time);&amp;#10;current_index = Number.parseInt(current_flash);&amp;#10;if ((((current_time &gt;= 0) &amp;&amp; (current_index &gt;= 0)) &amp;&amp; (current_index &lt; Num_of_flashes))) {&amp;#10;    flash_fraction = (current_flash - current_index);&amp;#10;    highlight = (highlights[current_index] - 1);&amp;#10;    if ((flash_fraction &lt; 0.67)) {&amp;#10;        squares[highlight].fillColor = highlight_color;&amp;#10;    } else {&amp;#10;        squares[highlight].fillColor = inactive_color;&amp;#10;    }&amp;#10;}&amp;#10;if ((current_time &gt;= end_time)) {&amp;#10;    for (var i, _pj_c = 0, _pj_a = util.range(9), _pj_b = _pj_a.length; (_pj_c &lt; _pj_b); _pj_c += 1) {&amp;#10;        i = _pj_a[_pj_c];&amp;#10;        if (mouse.isPressedIn(squares[i])) {&amp;#10;            if ((click_count &gt; 0)) {&amp;#10;                if ((squares_clicked[(click_count - 1)] === (i + 1))) {&amp;#10;                    break;&amp;#10;                }&amp;#10;            }&amp;#10;            squares_clicked.push((i + 1));&amp;#10;            click_count += 1;&amp;#10;            for (var j, _pj_f = 0, _pj_d = util.range(9), _pj_e = _pj_d.length; (_pj_f &lt; _pj_e); _pj_f += 1) {&amp;#10;                j = _pj_d[_pj_f];&amp;#10;                squares[j].fillColor = inactive_color;&amp;#10;            }&amp;#10;            squares[i].fillColor = activated_color;&amp;#10;            if ((click_count === Num_of_flashes)) {&amp;#10;                output_column_name = &quot;Output_sst&quot;.toString();&amp;#10;                psychoJS.experiment.addData(output_column_name, squares_clicked);&amp;#10;                for (var j, _pj_f = 0, _pj_d = util.range(Num_of_flashes), _pj_e = _pj_d.length; (_pj_f &lt; _pj_e); _pj_f += 1) {&amp;#10;                    j = _pj_d[_pj_f];&amp;#10;                    if ((squares_clicked[j] !== highlights[j])) {&amp;#10;                        SST_trials3.finished = true;&amp;#10;                    }&amp;#10;                }&amp;#10;                end_delay_time = current_time + end_delay;&amp;#10;            }&amp;#10;        }&amp;#10;    }&amp;#10;}&amp;#10;&amp;#10;if (current_time &gt;= end_delay_time)&amp;#10;{&amp;#10;    continueRoutine = false;&amp;#10;}" valType="extendedCode" updates="constant" name="Each JS Frame"/>
        <Param val="" valType="extendedCode" updates="constant" name="End Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="End JS Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="End JS Routine"/>
        <Param val="" valType="extendedCode" updates="constant" name="End Routine"/>
        <Param val="False" valType="bool" updates="None" name="disabled"/>
        <Param val="code_spatial_span_3" valType="code" updates="None" name="name"/>
      </CodeComponent>
