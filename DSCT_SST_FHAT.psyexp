 2), ('Fourth_sq', 4), ('Fifth_sq', 1), ('Sixth_sq', 6), ('Seventh_sq', 5), ('Eighth_sq', 7), ('Ninth_sq', 3), ('Tenth_sq', 0)]), OrderedDict([('Red', -1.0), ('Green', 0.5), ('Blue', -0.25), ('Num_of_squares', 10), ('First_sq', 1), ('Second_sq', 5), ('Third_sq', 6), ('Fourth_sq', 2), ('Fifth_sq', 9), ('Sixth_sq', 4), ('Seventh_sq', 9), ('Eighth_sq', 2), ('Ninth_sq', 1), ('Tenth_sq', 7)])]" valType="str"/>
