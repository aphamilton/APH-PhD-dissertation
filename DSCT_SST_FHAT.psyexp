    <Routine name="DSST_start_page">
      <CodeComponent name="set_stimuli">
        <Param val="" valType="extendedCode" updates="constant" name="Before Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Before JS Experiment"/>
        <Param val="ncols = 16&amp;#10;nrows = 9&amp;#10;cell_size = .04&amp;#10;pics = ['1.png','2.png','3.png','4.png','5.png','6.png','7.png','8.png','9.png']" valType="extendedCode" updates="constant" name="Begin Experiment"/>
        <Param val="ncols = 16;&amp;#10;nrows = 9;&amp;#10;cell_size = 0.04;&amp;#10;pics = [&quot;1.png&quot;, &quot;2.png&quot;, &quot;3.png&quot;, &quot;4.png&quot;, &quot;5.png&quot;, &quot;6.png&quot;, &quot;7.png&quot;, &quot;8.png&quot;, &quot;9.png&quot;];" valType="extendedCode" updates="constant" name="Begin JS Experiment"/>
        <Param val="counter = 0;&amp;#10;key_list = [];&amp;#10;xy_pos = [];&amp;#10;all_pics = [];&amp;#10;x_pos = function () {&amp;#10;    var _pj_a = [], _pj_b = util.range(ncols);&amp;#10;    for (var _pj_c = 0, _pj_d = _pj_b.length; (_pj_c &lt; _pj_d); _pj_c += 1) {&amp;#10;        var x0 = _pj_b[_pj_c];&amp;#10;        _pj_a.push(((- 0.3) + (x0 * 0.04)));&amp;#10;    }&amp;#10;    return _pj_a;&amp;#10;}&amp;#10;.call(this);&amp;#10;y_pos = function () {&amp;#10;    var _pj_a = [], _pj_b = util.range(nrows);&amp;#10;    for (var _pj_c = 0, _pj_d = _pj_b.length; (_pj_c &lt; _pj_d); _pj_c += 1) {&amp;#10;        var y0 = _pj_b[_pj_c];&amp;#10;        _pj_a.push((0.3 - (y0 * 0.08)));&amp;#10;    }&amp;#10;    return _pj_a;&amp;#10;}&amp;#10;.call(this);&amp;#10;for (var y0, _pj_c = 0, _pj_a = y_pos, _pj_b = _pj_a.length; (_pj_c &lt; _pj_b); _pj_c += 1) {&amp;#10;    y0 = _pj_a[_pj_c];&amp;#10;    for (var x0, _pj_f = 0, _pj_d = x_pos, _pj_e = _pj_d.length; (_pj_f &lt; _pj_e); _pj_f += 1) {&amp;#10;        x0 = _pj_d[_pj_f];&amp;#10;        xy_pos.push([x0, y0]);&amp;#10;        util.shuffle(pics);&amp;#10;        all_pics.push(pics[0]);&amp;#10;    }&amp;#10;}&amp;#10;img_list = [];&amp;#10;rect_list = [];&amp;#10;rect2_list = [];&amp;#10;input_list = [];&amp;#10;for (var i, _pj_c = 0, _pj_a = util.range(xy_pos.length), _pj_b = _pj_a.length; (_pj_c &lt; _pj_b); _pj_c += 1) {&amp;#10;    i = _pj_a[_pj_c];&amp;#10;    img_list.push(new visual.ImageStim({&quot;win&quot;: psychoJS.window, &quot;image&quot;: all_pics[i], &quot;pos&quot;: [xy_pos[i][0], xy_pos[i][1]], &quot;size&quot;: [cell_size, cell_size]}));&amp;#10;    rect_list.push(new visual.Rect({&quot;win&quot;: psychoJS.window, &quot;pos&quot;: [xy_pos[i][0], xy_pos[i][1]], &quot;width&quot;: cell_size, &quot;height&quot;: cell_size, &quot;lineColor&quot;: [(- 1), (- 1), (- 1)]}));&amp;#10;    rect2_list.push(new visual.Rect({&quot;win&quot;: psychoJS.window, &quot;pos&quot;: [xy_pos[i][0], (xy_pos[i][1] - cell_size)], &quot;width&quot;: cell_size, &quot;height&quot;: cell_size, &quot;lineColor&quot;: [(- 1), (- 1), (- 1)]}));&amp;#10;    input_list.push(new visual.TextStim({&quot;win&quot;: psychoJS.window, &quot;text&quot;: &quot; &quot;, &quot;font&quot;: &quot;Arial&quot;, &quot;pos&quot;: [xy_pos[i][0], (xy_pos[i][1] - cell_size)], &quot;height&quot;: cell_size, &quot;color&quot;: [(- 1), (- 1), (- 1)]}));&amp;#10;}&amp;#10;red_box = new visual.Rect({&quot;win&quot;: psychoJS.window, &quot;pos&quot;: [xy_pos[0][0], (xy_pos[0][1] - (cell_size / 2))], &quot;width&quot;: cell_size, &quot;height&quot;: (2 * cell_size), &quot;lineWidth&quot;: 3});&amp;#10;red_box.lineColor = new util.Color([1, -1, -1]);&amp;#10;&amp;#10;if (isTimerStarted == false)&amp;#10;{&amp;#10;    timer = new util.Clock();&amp;#10;    isTimerStarted = true;&amp;#10;}" valType="extendedCode" updates="constant" name="Begin JS Routine"/>
        <Param val="counter = 0&amp;#10;key_list = []&amp;#10;&amp;#10;# get all positions and picture order&amp;#10;xy_pos = [] # to store x y positions&amp;#10;all_pics = [] # to store stimuli in one page&amp;#10;x_pos = [-.3 + x0*.04 for x0 in range(ncols)]&amp;#10;y_pos = [.3 - y0*.08 for y0 in range(nrows)]&amp;#10;for y0 in y_pos:&amp;#10;    for x0 in x_pos:&amp;#10;        xy_pos.append([x0,y0])&amp;#10;        shuffle(pics)&amp;#10;        all_pics.append(pics[0])&amp;#10;&amp;#10;# construct stimuli objects&amp;#10;img_list = []&amp;#10;rect_list = []&amp;#10;rect2_list = []&amp;#10;input_list = []&amp;#10;for i in range(len(xy_pos)):&amp;#10;    # draw picture&amp;#10;    img_list.append(visual.ImageStim(&amp;#10;    win=win,&amp;#10;    image=all_pics[i], &amp;#10;    pos=[xy_pos[i][0], xy_pos[i][1]], &amp;#10;    size=[cell_size, cell_size])&amp;#10;    )&amp;#10;    # draw box around picture&amp;#10;    rect_list.append(visual.Rect(&amp;#10;    win=win,&amp;#10;    pos=[xy_pos[i][0], xy_pos[i][1]],&amp;#10;    width=cell_size,&amp;#10;    height=cell_size,&amp;#10;    lineColor=[-1,-1,-1])&amp;#10;    )&amp;#10;    # draw box around input&amp;#10;    rect2_list.append(visual.Rect(&amp;#10;    win=win,&amp;#10;    pos=[xy_pos[i][0], xy_pos[i][1]-cell_size],&amp;#10;    width=cell_size,&amp;#10;    height=cell_size,&amp;#10;    lineColor=[-1,-1,-1])&amp;#10;    )&amp;#10;    # draw placeholder for that will later be updated with actual input&amp;#10;    input_list.append(visual.TextStim(&amp;#10;    win=win,&amp;#10;    text=' ',&amp;#10;    font='Arial',&amp;#10;    pos=(xy_pos[i][0], xy_pos[i][1]-cell_size),&amp;#10;    height=cell_size,&amp;#10;    color=[-1,-1,-1])&amp;#10;    )&amp;#10;    &amp;#10;# draw box that highlight the current field&amp;#10;red_box = visual.Rect(&amp;#10;win=win,&amp;#10;pos=[xy_pos[0][0], xy_pos[0][1]-cell_size/2],&amp;#10;width=cell_size,&amp;#10;height=2*cell_size,&amp;#10;lineWidth=3)&amp;#10;red_box.lineColor = 'red'&amp;#10;&amp;#10;if isTimerStarted == False:&amp;#10;    timer = core.Clock()&amp;#10;    isTimerStarted = True" valType="extendedCode" updates="constant" name="Begin Routine"/>
        <Param val="Both" valType="str" updates="None" name="Code Type"/>
        <Param val="" valType="extendedCode" updates="constant" name="Each Frame"/>
        <Param val="" valType="extendedCode" updates="constant" name="Each JS Frame"/>
        <Param val="" valType="extendedCode" updates="constant" name="End Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="End JS Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="End JS Routine"/>
        <Param val="" valType="extendedCode" updates="constant" name="End Routine"/>
        <Param val="False" valType="bool" updates="None" name="disabled"/>
        <Param val="set_stimuli" valType="code" updates="None" name="name"/>
      </CodeComponent>
    </Routine>
