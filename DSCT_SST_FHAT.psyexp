    <Param val="['spatial_span_key3.csv', 'spatial_span_key2.csv', 'spatial_span_key.csv', 'FHA_MI_COAXING.mp4', 'FHA_MI_MOCKING.mp4', 'FHA_MI_SEDUCING.mp4', 'FHA_NI_BILLIARD.mp4', 'FHA_NI_STAR.mp4', 'FHA_NI_TENNIS.mp4', 'FHA_PI_CHASE.mp4', 'FHA_PI_DANCING.mp4', 'FHA_PI_LEADING.mp4', 'finaltestinstructions.png', 'key.png', '1.png', '2.png', '3.png', '4.png', '5.png', '6.png', '7.png', '8.png', '9.png', 'animations_key.csv']" valType="fileList" updates="None" name="Resources"/>
    <Param val="False" valType="bool" updates="None" name="Save csv file"/>
    <Param val="False" valType="bool" updates="None" name="Save excel file"/>
    <Param val="False" valType="bool" updates="None" name="Save hdf5 file"/>
