        <Param val="" valType="code" updates="constant" name="stopVal"/>
        <Param val="True" valType="bool" updates="None" name="syncScreenRefresh"/>
        <Param val="Sur l'écran suivant, vous verrez neuf cases grises. Une série de ces cases clignotera en couleur et vous devrez vous souvenir de l'ordre dans lequel ces cases ont clignoté. Quand ils arrêtent de clignoter, il vous sera demandé de cliquer sur ces cases dans ce même ordre. Par la suite, une nouvelle série clignotera dans un autre couleur et vous devrez encore identifier l’ordre. Le nombre de boîtes dans la série augmentera progressivement chaque fois.&amp;#10;&amp;#10;Appuyiez sur ESPACE pour continuer." valType="extendedStr" updates="constant" name="text"/>
