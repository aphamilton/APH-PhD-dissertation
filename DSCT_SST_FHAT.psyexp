  <Routines>
    <Routine name="DSST_settings">
      <CodeComponent name="js_funcs">
        <Param val="" valType="extendedCode" updates="constant" name="Before Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Before JS Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Begin Experiment"/>
        <Param val="if( /Android|webOS|iPhone|iPad|iPod|BlackBerry|IEMobile|Opera Mini/i.test(navigator.userAgent) ) {&amp;#10;  quitPsychoJS('Mobile device detected. Goodbye!', false)&amp;#10;}&amp;#10;&amp;#10;event=psychoJS.eventManager;&amp;#10;&amp;#10;thisExp=psychoJS.experiment;&amp;#10;&amp;#10;win=psychoJS.window;&amp;#10;&amp;#10;shuffle = util.shuffle;&amp;#10;&amp;#10;Array.prototype.append = [].push;&amp;#10;&amp;#10;range = function (size, startAt = 0) {&amp;#10;    return [...Array(size).keys()].map(i =&gt; i + startAt);&amp;#10;}&amp;#10;&amp;#10;$.getJSON('https://api.ipify.org?format=json', function(data){&amp;#10;&amp;#10;console.log(data.ip);&amp;#10;localStorage.setItem('ip',data.ip);&amp;#10;&amp;#10;psychoJS.experiment.addData('IP_Addresss', data.ip)&amp;#10;&amp;#10;});&amp;#10;&amp;#10;document.body.style.cursor='none';&amp;#10;&amp;#10;&amp;#10;" valType="extendedCode" updates="constant" name="Begin JS Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Begin JS Routine"/>
        <Param val="" valType="extendedCode" updates="constant" name="Begin Routine"/>
        <Param val="JS" valType="str" updates="None" name="Code Type"/>
        <Param val="" valType="extendedCode" updates="constant" name="Each Frame"/>
        <Param val="" valType="extendedCode" updates="constant" name="Each JS Frame"/>
        <Param val="" valType="extendedCode" updates="constant" name="End Experiment"/>
        <Param val="document.body.style.cursor='auto';&amp;#10;" valType="extendedCode" updates="constant" name="End JS Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="End JS Routine"/>
        <Param val="" valType="extendedCode" updates="constant" name="End Routine"/>
        <Param val="False" valType="bool" updates="None" name="disabled"/>
        <Param val="js_funcs" valType="code" updates="None" name="name"/>
      </CodeComponent>
      <CodeComponent name="colors">
        <Param val="" valType="extendedCode" updates="constant" name="Before Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Before JS Experiment"/>
        <Param val="white=[1,1,1]&amp;#10;grey=[.2,.2,.2]&amp;#10;yellow=[1,1,0]&amp;#10;green=[-1,0,-1]&amp;#10;black=[-1,-1,-1]&amp;#10;red=[1,-1,-1]&amp;#10;" valType="extendedCode" updates="constant" name="Begin Experiment"/>
        <Param val="white = [1, 1, 1];&amp;#10;grey = [0.2, 0.2, 0.2];&amp;#10;yellow = [1, 1, 0];&amp;#10;green = [(- 1), 0, (- 1)];&amp;#10;black = [(- 1), (- 1), (- 1)];&amp;#10;red = [1, (- 1), (- 1)];&amp;#10;" valType="extendedCode" updates="constant" name="Begin JS Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Begin JS Routine"/>
        <Param val="" valType="extendedCode" updates="constant" name="Begin Routine"/>
        <Param val="Auto-&gt;JS" valType="str" updates="None" name="Code Type"/>
        <Param val="" valType="extendedCode" updates="constant" name="Each Frame"/>
        <Param val="" valType="extendedCode" updates="constant" name="Each JS Frame"/>
        <Param val="" valType="extendedCode" updates="constant" name="End Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="End JS Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="End JS Routine"/>
        <Param val="" valType="extendedCode" updates="constant" name="End Routine"/>
        <Param val="False" valType="bool" updates="None" name="disabled"/>
        <Param val="colors" valType="code" updates="None" name="name"/>
      </CodeComponent>
      <CodeComponent name="set_practice">
        <Param val="" valType="extendedCode" updates="constant" name="Before Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Before JS Experiment"/>
        <Param val="ncols = 16&amp;#10;nrows = 9&amp;#10;cell_size = .04&amp;#10;pics = ['1.png','2.png','3.png','4.png','5.png','6.png','7.png','8.png','9.png']" valType="extendedCode" updates="constant" name="Begin Experiment"/>
        <Param val="ncols = 16;&amp;#10;nrows = 9;&amp;#10;cell_size = 0.04;&amp;#10;pics = [&quot;1.png&quot;, &quot;2.png&quot;, &quot;3.png&quot;, &quot;4.png&quot;, &quot;5.png&quot;, &quot;6.png&quot;, &quot;7.png&quot;, &quot;8.png&quot;, &quot;9.png&quot;];&amp;#10;" valType="extendedCode" updates="constant" name="Begin JS Experiment"/>
        <Param val="counter = 3;&amp;#10;key_list = [];&amp;#10;xy_pos = [];&amp;#10;all_pics = [&quot;3.png&quot;, &quot;1.png&quot;, &quot;5.png&quot;, &quot;4.png&quot;, &quot;9.png&quot;, &quot;7.png&quot;, &quot;2.png&quot;, &quot;8.png&quot;, &quot;6.png&quot;];&amp;#10;x_pos = function () {&amp;#10;    var _pj_a = [], _pj_b = util.range(9);&amp;#10;    for (var _pj_c = 0, _pj_d = _pj_b.length; (_pj_c &lt; _pj_d); _pj_c += 1) {&amp;#10;        var x0 = _pj_b[_pj_c];&amp;#10;        _pj_a.push(((- 0.16) + (x0 * 0.04)));&amp;#10;    }&amp;#10;    return _pj_a;&amp;#10;}&amp;#10;.call(this);&amp;#10;y_pos = [(- 0.2)];&amp;#10;for (var y0, _pj_c = 0, _pj_a = y_pos, _pj_b = _pj_a.length; (_pj_c &lt; _pj_b); _pj_c += 1) {&amp;#10;    y0 = _pj_a[_pj_c];&amp;#10;    for (var x0, _pj_f = 0, _pj_d = x_pos, _pj_e = _pj_d.length; (_pj_f &lt; _pj_e); _pj_f += 1) {&amp;#10;        x0 = _pj_d[_pj_f];&amp;#10;        xy_pos.push([x0, y0]);&amp;#10;    }&amp;#10;}&amp;#10;img_list = [];&amp;#10;rect_list = [];&amp;#10;rect2_list = [];&amp;#10;input_list = [];&amp;#10;for (var i, _pj_c = 0, _pj_a = util.range(xy_pos.length), _pj_b = _pj_a.length; (_pj_c &lt; _pj_b); _pj_c += 1) {&amp;#10;    i = _pj_a[_pj_c];&amp;#10;    img_list.push(new visual.ImageStim({&quot;win&quot;: psychoJS.window, &quot;image&quot;: all_pics[i], &quot;pos&quot;: [xy_pos[i][0], xy_pos[i][1]], &quot;size&quot;: [cell_size, cell_size]}));&amp;#10;    rect_list.push(new visual.Rect({&quot;win&quot;: psychoJS.window, &quot;pos&quot;: [xy_pos[i][0], xy_pos[i][1]], &quot;width&quot;: cell_size, &quot;height&quot;: cell_size, &quot;lineColor&quot;: [(- 1), (- 1), (- 1)]}));&amp;#10;    rect2_list.push(new visual.Rect({&quot;win&quot;: psychoJS.window, &quot;pos&quot;: [xy_pos[i][0], (xy_pos[i][1] - cell_size)], &quot;width&quot;: cell_size, &quot;height&quot;: cell_size, &quot;lineColor&quot;: [(- 1), (- 1), (- 1)]}));&amp;#10;    if ((i &lt; 3)) {&amp;#10;        input_list.push(new visual.TextStim({&quot;win&quot;: psychoJS.window, &quot;text&quot;: all_pics[i][0], &quot;font&quot;: &quot;Arial&quot;, &quot;pos&quot;: [xy_pos[i][0], (xy_pos[i][1] - cell_size)], &quot;height&quot;: cell_size, &quot;color&quot;: [(- 1), (- 1), (- 1)]}));&amp;#10;    } else {&amp;#10;        input_list.push(new visual.TextStim({&quot;win&quot;: psychoJS.window, &quot;text&quot;: &quot; &quot;, &quot;font&quot;: &quot;Arial&quot;, &quot;pos&quot;: [xy_pos[i][0], (xy_pos[i][1] - cell_size)], &quot;height&quot;: cell_size, &quot;color&quot;: [(- 1), (- 1), (- 1)]}));&amp;#10;    }&amp;#10;}&amp;#10;red_box = new visual.Rect({&quot;win&quot;: psychoJS.window, &quot;pos&quot;: [xy_pos[3][0], (xy_pos[3][1] - (cell_size / 2))], &quot;width&quot;: cell_size, &quot;height&quot;: (2 * cell_size), &quot;lineWidth&quot;: 3, &quot;lineColor&quot;: new util.Color([1, -1, -1])});&amp;#10;error = new visual.TextStim({&quot;win&quot;: psychoJS.window, &quot;text&quot;: &quot;Please type in the correct number!&quot;, &quot;font&quot;: &quot;Arial&quot;, &quot;pos&quot;: [0, (- 0.4)], &quot;height&quot;: 0.025, &quot;color&quot;: [1, (- 1), (- 1)]});&amp;#10;" valType="extendedCode" updates="constant" name="Begin JS Routine"/>
        <Param val="counter = 3&amp;#10;key_list = []&amp;#10;&amp;#10;# get all positions and picture order&amp;#10;xy_pos = [] # to store x y positions&amp;#10;all_pics = ['3.png','1.png','5.png','4.png','9.png','7.png','2.png','8.png','6.png'] # to store stimuli in one page&amp;#10;x_pos = [-.16 + x0*.04 for x0 in range(9)]&amp;#10;y_pos = [-.2]&amp;#10;for y0 in y_pos:&amp;#10;    for x0 in x_pos:&amp;#10;        xy_pos.append([x0,y0])&amp;#10;&amp;#10;# construct stimuli objects&amp;#10;img_list = []&amp;#10;rect_list = []&amp;#10;rect2_list = []&amp;#10;input_list = []&amp;#10;for i in range(len(xy_pos)):&amp;#10;    # draw picture&amp;#10;    img_list.append(visual.ImageStim(&amp;#10;    win=win,&amp;#10;    image=all_pics[i], &amp;#10;    pos=[xy_pos[i][0], xy_pos[i][1]], &amp;#10;    size=[cell_size, cell_size])&amp;#10;    )&amp;#10;    # draw box around picture&amp;#10;    rect_list.append(visual.Rect(&amp;#10;    win=win,&amp;#10;    pos=[xy_pos[i][0], xy_pos[i][1]],&amp;#10;    width=cell_size,&amp;#10;    height=cell_size,&amp;#10;    lineColor=[-1,-1,-1])&amp;#10;    )&amp;#10;    # draw box around input&amp;#10;    rect2_list.append(visual.Rect(&amp;#10;    win=win,&amp;#10;    pos=[xy_pos[i][0], xy_pos[i][1]-cell_size],&amp;#10;    width=cell_size,&amp;#10;    height=cell_size,&amp;#10;    lineColor=[-1,-1,-1])&amp;#10;    )&amp;#10;    &amp;#10;    # draw placeholder for that will later be updated with actual input&amp;#10;    if i &lt; 3:&amp;#10;        input_list.append(visual.TextStim(&amp;#10;        win=win,&amp;#10;        text=all_pics[i][0],&amp;#10;        font='Arial',&amp;#10;        pos=(xy_pos[i][0], xy_pos[i][1]-cell_size),&amp;#10;        height=cell_size,&amp;#10;        color=[-1,-1,-1])&amp;#10;        )&amp;#10;    else:&amp;#10;        input_list.append(visual.TextStim(&amp;#10;        win=win,&amp;#10;        text=' ',&amp;#10;        font='Arial',&amp;#10;        pos=(xy_pos[i][0], xy_pos[i][1]-cell_size),&amp;#10;        height=cell_size,&amp;#10;        color=[-1,-1,-1])&amp;#10;        )&amp;#10;    &amp;#10;# draw box that highlight the current field&amp;#10;red_box = visual.Rect(&amp;#10;win=win,&amp;#10;pos=[xy_pos[3][0], xy_pos[3][1]-cell_size/2],&amp;#10;width=cell_size,&amp;#10;height=2*cell_size,&amp;#10;lineWidth=3,&amp;#10;lineColor=red)&amp;#10;&amp;#10;# error feedback&amp;#10;error = visual.TextStim(&amp;#10;        win=win,&amp;#10;        text='Please type in the correct number!',&amp;#10;        font='Arial',&amp;#10;        pos=(0, -.4),&amp;#10;        height=.025,&amp;#10;        color=[1,-1,-1])" valType="extendedCode" updates="constant" name="Begin Routine"/>
        <Param val="Both" valType="str" updates="None" name="Code Type"/>
        <Param val="" valType="extendedCode" updates="constant" name="Each Frame"/>
        <Param val="" valType="extendedCode" updates="constant" name="Each JS Frame"/>
        <Param val="" valType="extendedCode" updates="constant" name="End Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="End JS Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="End JS Routine"/>
        <Param val="" valType="extendedCode" updates="constant" name="End Routine"/>
        <Param val="False" valType="bool" updates="None" name="disabled"/>
        <Param val="set_practice" valType="code" updates="None" name="name"/>
      </CodeComponent>
    </Routine>
    <Routine name="DSST_prac">
      <CodeComponent name="code_practice">
        <Param val="" valType="extendedCode" updates="constant" name="Before Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Before JS Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Begin Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Begin JS Experiment"/>
        <Param val="for (var i, _pj_c = 0, _pj_a = img_list, _pj_b = _pj_a.length; (_pj_c &lt; _pj_b); _pj_c += 1) {&amp;#10;    i = _pj_a[_pj_c];&amp;#10;    i.setAutoDraw(true);&amp;#10;}&amp;#10;for (var i, _pj_c = 0, _pj_a = rect_list, _pj_b = _pj_a.length; (_pj_c &lt; _pj_b); _pj_c += 1) {&amp;#10;    i = _pj_a[_pj_c];&amp;#10;    i.setAutoDraw(true);&amp;#10;}&amp;#10;for (var i, _pj_c = 0, _pj_a = rect2_list, _pj_b = _pj_a.length; (_pj_c &lt; _pj_b); _pj_c += 1) {&amp;#10;    i = _pj_a[_pj_c];&amp;#10;    i.setAutoDraw(true);&amp;#10;}&amp;#10;for (var i, _pj_c = 0, _pj_a = input_list, _pj_b = _pj_a.length; (_pj_c &lt; _pj_b); _pj_c += 1) {&amp;#10;    i = _pj_a[_pj_c];&amp;#10;    i.setAutoDraw(true);&amp;#10;}&amp;#10;red_box.pos = [xy_pos[counter][0], (xy_pos[counter][1] - (cell_size / 2))];&amp;#10;red_box.setAutoDraw(true);&amp;#10;correct_key = all_pics[counter][0];&amp;#10;" valType="extendedCode" updates="constant" name="Begin JS Routine"/>
        <Param val="#img_list[1] = visual.ImageStim(&amp;#10;#    win=win,&amp;#10;#    image=all_pics[1],&amp;#10;#    pos=[xy_pos[1][0]/2, xy_pos[1][1]/2], &amp;#10;#    size=[cell_size, cell_size])&amp;#10;    &amp;#10;#img_list.append(visual.ImageStim(&amp;#10;#    win=win,&amp;#10;#    image=all_pics[i], &amp;#10;#    pos=[xy_pos[i][0], xy_pos[i][1]], &amp;#10;#    size=[cell_size, cell_size])&amp;#10;#    )&amp;#10;&amp;#10;&amp;#10;# display components&amp;#10;for i in rect_list:&amp;#10;    i.setAutoDraw(True)&amp;#10;&amp;#10;for i in rect2_list:&amp;#10;    i.setAutoDraw(True)&amp;#10;&amp;#10;red_box.pos = [xy_pos[counter][0], xy_pos[counter][1]-cell_size/2]  &amp;#10;red_box.setAutoDraw(True)&amp;#10;&amp;#10;for i in img_list:&amp;#10;    i.setAutoDraw(True)&amp;#10;&amp;#10;for i in input_list:&amp;#10;    i.setAutoDraw(True)&amp;#10;    &amp;#10;#first_pic = visual.ImageStim(&amp;#10;#    win=win,&amp;#10;#    image='1.png',&amp;#10;#    pos=[-0.4, -0.4], &amp;#10;#    size=[cell_size, cell_size])&amp;#10;    &amp;#10;#first_pic.setAutoDraw(True)&amp;#10;#img_list[2].setAutoDraw(True)&amp;#10;&amp;#10;# decide correctness&amp;#10;correct_key = all_pics[counter][0]" valType="extendedCode" updates="constant" name="Begin Routine"/>
        <Param val="Both" valType="str" updates="None" name="Code Type"/>
        <Param val="" valType="extendedCode" updates="constant" name="Each Frame"/>
        <Param val="" valType="extendedCode" updates="constant" name="Each JS Frame"/>
        <Param val="" valType="extendedCode" updates="constant" name="End Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="End JS Experiment"/>
        <Param val="thisExp.addData(&quot;img&quot;, all_pics[counter]);&amp;#10;thisExp.addData(&quot;correct_key&quot;, correct_key);&amp;#10;if ((practice_resp.corr === 1)) {&amp;#10;    key_list.append(practice_resp.keys);&amp;#10;    for (var i = 0, _pj_a = key_list.length; (i &lt; _pj_a); i += 1) {&amp;#10;        input_list[(i + 3)].text = key_list[i];&amp;#10;    }&amp;#10;    counter = (counter + 1);&amp;#10;    practice_loop.finished = true;&amp;#10;    error.setAutoDraw(false);&amp;#10;} else {&amp;#10;    error.setAutoDraw(true);&amp;#10;}&amp;#10;for (var i, _pj_c = 0, _pj_a = img_list, _pj_b = _pj_a.length; (_pj_c &lt; _pj_b); _pj_c += 1) {&amp;#10;    i = _pj_a[_pj_c];&amp;#10;    i.setAutoDraw(false);&amp;#10;}&amp;#10;for (var i, _pj_c = 0, _pj_a = rect_list, _pj_b = _pj_a.length; (_pj_c &lt; _pj_b); _pj_c += 1) {&amp;#10;    i = _pj_a[_pj_c];&amp;#10;    i.setAutoDraw(false);&amp;#10;}&amp;#10;for (var i, _pj_c = 0, _pj_a = rect2_list, _pj_b = _pj_a.length; (_pj_c &lt; _pj_b); _pj_c += 1) {&amp;#10;    i = _pj_a[_pj_c];&amp;#10;    i.setAutoDraw(false);&amp;#10;}&amp;#10;for (var i, _pj_c = 0, _pj_a = input_list, _pj_b = _pj_a.length; (_pj_c &lt; _pj_b); _pj_c += 1) {&amp;#10;    i = _pj_a[_pj_c];&amp;#10;    i.setAutoDraw(false);&amp;#10;}&amp;#10;red_box.setAutoDraw(false);&amp;#10;" valType="extendedCode" updates="constant" name="End JS Routine"/>
        <Param val="# log data&amp;#10;thisExp.addData('img', all_pics[counter])&amp;#10;thisExp.addData('correct_key', correct_key)&amp;#10;&amp;#10;&amp;#10;if practice_resp.corr == 1:&amp;#10;    # get response&amp;#10;    key_list.append(practice_resp.keys)&amp;#10;    &amp;#10;    # update text object&amp;#10;    for i in range(len(key_list)):&amp;#10;        input_list[i+3].text=key_list[i]&amp;#10;        &amp;#10;    # update trial count&amp;#10;    counter = counter + 1&amp;#10;    &amp;#10;    # end loop&amp;#10;    practice_loop.finished=True&amp;#10;    error.setAutoDraw(False)&amp;#10;else:&amp;#10;    # show error&amp;#10;    error.setAutoDraw(True)&amp;#10;&amp;#10;# clear components&amp;#10;for i in img_list:&amp;#10;    i.setAutoDraw(False)&amp;#10;&amp;#10;for i in rect_list:&amp;#10;    i.setAutoDraw(False)&amp;#10;&amp;#10;for i in rect2_list:&amp;#10;    i.setAutoDraw(False)&amp;#10;&amp;#10;for i in input_list:&amp;#10;    i.setAutoDraw(False) &amp;#10;&amp;#10;red_box.setAutoDraw(False)" valType="extendedCode" updates="constant" name="End Routine"/>
        <Param val="False" valType="bool" updates="None" name="disabled"/>
        <Param val="code_practice" valType="code" updates="None" name="name"/>
