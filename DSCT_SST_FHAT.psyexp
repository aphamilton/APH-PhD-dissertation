        <Param val="" valType="code" updates="constant" name="stopVal"/>
        <Param val="True" valType="bool" updates="None" name="syncScreenRefresh"/>
        <Param val="On the next screen you will see nine grey boxes. A series of them will flash in color and you will need to remember the order in which they flashed. When they stop flashing, click on them in that order. Then, a new series will flash in another color and you will identify the order again. The number of boxes in the series will gradually increase.&amp;#10;&amp;#10;Press SPACE to continue." valType="extendedStr" updates="constant" name="text"/>
        <Param val="from exp settings" valType="str" updates="None" name="units"/>
        <Param val="" valType="code" updates="constant" name="wrapWidth"/>
      </TextComponent>
