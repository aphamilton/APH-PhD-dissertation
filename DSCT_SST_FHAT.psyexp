    <Routine name="DSST_trial">
      <CodeComponent name="code">
        <Param val="" valType="extendedCode" updates="constant" name="Before Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Before JS Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Begin Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Begin JS Experiment"/>
        <Param val="for (var i, _pj_c = 0, _pj_a = rect_list, _pj_b = _pj_a.length; (_pj_c &lt; _pj_b); _pj_c += 1) {&amp;#10;    i = _pj_a[_pj_c];&amp;#10;    i.setAutoDraw(true);&amp;#10;}&amp;#10;for (var i, _pj_c = 0, _pj_a = rect2_list, _pj_b = _pj_a.length; (_pj_c &lt; _pj_b); _pj_c += 1) {&amp;#10;    i = _pj_a[_pj_c];&amp;#10;    i.setAutoDraw(true);&amp;#10;}&amp;#10;red_box.pos = [xy_pos[counter][0], (xy_pos[counter][1] - (cell_size / 2))];&amp;#10;red_box.setAutoDraw(true);&amp;#10;for (var i, _pj_c = 0, _pj_a = img_list, _pj_b = _pj_a.length; (_pj_c &lt; _pj_b); _pj_c += 1) {&amp;#10;    i = _pj_a[_pj_c];&amp;#10;    i.setAutoDraw(true);&amp;#10;}&amp;#10;for (var i, _pj_c = 0, _pj_a = input_list, _pj_b = _pj_a.length; (_pj_c &lt; _pj_b); _pj_c += 1) {&amp;#10;    i = _pj_a[_pj_c];&amp;#10;    i.setAutoDraw(true);&amp;#10;}&amp;#10;correct_key = all_pics[counter][0];&amp;#10;" valType="extendedCode" updates="constant" name="Begin JS Routine"/>
        <Param val="# display components&amp;#10;for i in rect_list:&amp;#10;    i.setAutoDraw(True)&amp;#10;&amp;#10;for i in rect2_list:&amp;#10;    i.setAutoDraw(True)&amp;#10;&amp;#10;#if len(display_list) &gt; 0:&amp;#10;#    for i in display_list:&amp;#10;#        i.setAutoDraw(True)&amp;#10;&amp;#10;red_box.pos = [xy_pos[counter][0], xy_pos[counter][1]-cell_size/2]  &amp;#10;red_box.setAutoDraw(True)&amp;#10;&amp;#10;for i in img_list:&amp;#10;    i.setAutoDraw(True)&amp;#10;&amp;#10;for i in input_list:&amp;#10;    i.setAutoDraw(True)&amp;#10;&amp;#10;# decide correctness&amp;#10;correct_key = all_pics[counter][0]" valType="extendedCode" updates="constant" name="Begin Routine"/>
        <Param val="Auto-&gt;JS" valType="str" updates="None" name="Code Type"/>
        <Param val="current_time = round(max_time - timer.getTime(), 0)&amp;#10;&amp;#10;if timer.getTime() &gt; max_time:&amp;#10;    #continueRoutine = False&amp;#10;    loop.finished = True&amp;#10;    page_loop.finished = True&amp;#10;    " valType="extendedCode" updates="constant" name="Each Frame"/>
        <Param val="current_time = Math.round((max_time - timer.getTime()), 0);&amp;#10;if ((timer.getTime() &gt; max_time)) {&amp;#10;    loop.finished = true;&amp;#10;    page_loop.finished = true;&amp;#10;}&amp;#10;" valType="extendedCode" updates="constant" name="Each JS Frame"/>
        <Param val="" valType="extendedCode" updates="constant" name="End Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="End JS Experiment"/>
        <Param val="key_list.append(resp.keys);&amp;#10;for (var i = 0, _pj_a = key_list.length; (i &lt; _pj_a); i += 1) {&amp;#10;    input_list[i].text = key_list[i];&amp;#10;}&amp;#10;for (var i, _pj_c = 0, _pj_a = img_list, _pj_b = _pj_a.length; (_pj_c &lt; _pj_b); _pj_c += 1) {&amp;#10;    i = _pj_a[_pj_c];&amp;#10;    i.setAutoDraw(false);&amp;#10;}&amp;#10;for (var i, _pj_c = 0, _pj_a = rect_list, _pj_b = _pj_a.length; (_pj_c &lt; _pj_b); _pj_c += 1) {&amp;#10;    i = _pj_a[_pj_c];&amp;#10;    i.setAutoDraw(false);&amp;#10;}&amp;#10;for (var i, _pj_c = 0, _pj_a = rect2_list, _pj_b = _pj_a.length; (_pj_c &lt; _pj_b); _pj_c += 1) {&amp;#10;    i = _pj_a[_pj_c];&amp;#10;    i.setAutoDraw(false);&amp;#10;}&amp;#10;for (var i, _pj_c = 0, _pj_a = input_list, _pj_b = _pj_a.length; (_pj_c &lt; _pj_b); _pj_c += 1) {&amp;#10;    i = _pj_a[_pj_c];&amp;#10;    i.setAutoDraw(false);&amp;#10;}&amp;#10;red_box.setAutoDraw(false);&amp;#10;thisExp.addData(&quot;img&quot;, all_pics[counter]);&amp;#10;thisExp.addData(&quot;correct_key&quot;, correct_key);&amp;#10;thisExp.addData(&quot;current_time&quot;, current_time);&amp;#10;counter = (counter + 1);&amp;#10;" valType="extendedCode" updates="constant" name="End JS Routine"/>
        <Param val="# get response&amp;#10;key_list.append(resp.keys)&amp;#10;&amp;#10;# update text object&amp;#10;for i in range(len(key_list)):&amp;#10;    input_list[i].text=key_list[i]&amp;#10;&amp;#10;#disp_txt = visual.TextStim(win=win,&amp;#10;#text=resp.keys,&amp;#10;#font='Arial',&amp;#10;#pos=(xy_pos[counter][0], xy_pos[counter][1]-cell_size),&amp;#10;#height=cell_size,&amp;#10;#color=[-1,-1,-1])&amp;#10;&amp;#10;#disp_txt.text=resp.keys&amp;#10;#disp_txt.pos=(xy_pos[counter][0], xy_pos[counter][1]-cell_size)&amp;#10;&amp;#10;# clear components&amp;#10;for i in img_list:&amp;#10;    i.setAutoDraw(False)&amp;#10;&amp;#10;for i in rect_list:&amp;#10;    i.setAutoDraw(False)&amp;#10;&amp;#10;for i in rect2_list:&amp;#10;    i.setAutoDraw(False)&amp;#10;&amp;#10;for i in input_list:&amp;#10;    i.setAutoDraw(False) &amp;#10;&amp;#10;red_box.setAutoDraw(False)&amp;#10;&amp;#10;# log data&amp;#10;thisExp.addData('img', all_pics[counter])&amp;#10;thisExp.addData('correct_key', correct_key)&amp;#10;thisExp.addData('current_time', current_time)&amp;#10;&amp;#10;# update trial count&amp;#10;counter = counter + 1&amp;#10;" valType="extendedCode" updates="constant" name="End Routine"/>
        <Param val="False" valType="bool" updates="None" name="disabled"/>
        <Param val="code" valType="code" updates="None" name="name"/>
      </CodeComponent>
      <ImageComponent name="key_image">
        <Param val="center" valType="str" updates="constant" name="anchor"/>
        <Param val="$[1.000,1.000,1.000]" valType="str" updates="constant" name="color"/>
        <Param val="rgb" valType="str" updates="constant" name="colorSpace"/>
        <Param val="1" valType="num" updates="constant" name="contrast"/>
        <Param val="False" valType="bool" updates="None" name="disabled"/>
        <Param val="" valType="code" updates="None" name="durationEstim"/>
        <Param val="False" valType="bool" updates="constant" name="flipHoriz"/>
        <Param val="False" valType="bool" updates="constant" name="flipVert"/>
        <Param val="key.png" valType="str" updates="constant" name="image"/>
        <Param val="linear" valType="str" updates="constant" name="interpolate"/>
        <Param val="None" valType="str" updates="constant" name="mask"/>
        <Param val="key_image" valType="code" updates="None" name="name"/>
        <Param val="1" valType="code" updates="constant" name="opacity"/>
        <Param val="0" valType="code" updates="constant" name="ori"/>
        <Param val="(0, 0.4)" valType="list" updates="constant" name="pos"/>
        <Param val="True" valType="bool" updates="None" name="saveStartStop"/>
        <Param val="(0.5, 0.1)" valType="list" updates="constant" name="size"/>
        <Param val="" valType="code" updates="None" name="startEstim"/>
        <Param val="time (s)" valType="str" updates="None" name="startType"/>
        <Param val="0.0" valType="code" updates="None" name="startVal"/>
        <Param val="duration (s)" valType="str" updates="None" name="stopType"/>
        <Param val="" valType="code" updates="constant" name="stopVal"/>
        <Param val="True" valType="bool" updates="None" name="syncScreenRefresh"/>
        <Param val="128" valType="code" updates="constant" name="texture resolution"/>
        <Param val="from exp settings" valType="str" updates="None" name="units"/>
      </ImageComponent>
      <TextComponent name="text">
        <Param val="$[-1.000,-1.000,-1.000]" valType="str" updates="constant" name="color"/>
        <Param val="rgb" valType="str" updates="constant" name="colorSpace"/>
        <Param val="1" valType="num" updates="constant" name="contrast"/>
        <Param val="False" valType="bool" updates="None" name="disabled"/>
        <Param val="" valType="code" updates="None" name="durationEstim"/>
        <Param val="" valType="str" updates="constant" name="flip"/>
        <Param val="Arial" valType="str" updates="constant" name="font"/>
        <Param val="LTR" valType="str" updates="None" name="languageStyle"/>
        <Param val="0.03" valType="code" updates="constant" name="letterHeight"/>
        <Param val="text" valType="code" updates="None" name="name"/>
        <Param val="1" valType="code" updates="constant" name="opacity"/>
        <Param val="0" valType="code" updates="constant" name="ori"/>
        <Param val="(.45, .45)" valType="list" updates="constant" name="pos"/>
